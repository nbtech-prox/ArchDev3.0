# ==========================================
# ZSH Modular Setup (Professional)
# ==========================================

# Base system
source ~/.config/zsh/core.zsh

# Aliases
source ~/.config/zsh/aliases.zsh

# FZF + Zoxide
source ~/.config/zsh/fzf.zsh

# Dev tools (Laravel / Git / Launcher)
source ~/.config/zsh/dev.zsh

# Environment (asdf / direnv / starship)
source ~/.config/zsh/env.zsh