#!/bin/bash

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/archdev"
LAST_APPLY_FILE="$STATE_DIR/last-apply.env"

usage() {
  cat <<'EOF'
ArchDev rollback helper

Uso:
  archdev-rollback list
  archdev-rollback last
  archdev-rollback create [descricao]
  archdev-rollback <snapshot_id>

Comandos:
  list              Lista snapshots Snapper
  last              Faz rollback para o último snapshot pre-apply conhecido
  create            Cria snapshot manual com descrição opcional
  <snapshot_id>     Faz rollback para um snapshot específico
EOF
}

need_sudo() {
  if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
    sudo "$@"
  else
    "$@"
  fi
}

require_snapper() {
  if ! command -v snapper >/dev/null 2>&1; then
    echo "❌ Snapper não está instalado."
    exit 1
  fi

  if ! need_sudo snapper -c root get-config >/dev/null 2>&1; then
    echo "❌ Snapper root não está configurado."
    exit 1
  fi
}

load_last_snapshot() {
  if [[ ! -f "$LAST_APPLY_FILE" ]]; then
    echo "❌ Não existe estado anterior em $LAST_APPLY_FILE"
    exit 1
  fi

  # shellcheck disable=SC1090
  source "$LAST_APPLY_FILE"

  if [[ -z "${ARCHDEV_PRE_SNAPSHOT:-}" ]]; then
    echo "❌ O ficheiro de estado não tem ARCHDEV_PRE_SNAPSHOT"
    exit 1
  fi

  echo "$ARCHDEV_PRE_SNAPSHOT"
}

create_snapshot() {
  local description="${1:-manual-$(date +%Y%m%d-%H%M%S)}"
  require_snapper
  need_sudo snapper -c root create --description "ArchDev-${description}" --cleanup-algorithm number
}

list_snapshots() {
  require_snapper
  need_sudo snapper -c root list
}

rollback_snapshot() {
  local snapshot_id="$1"

  require_snapper

  if [[ ! "$snapshot_id" =~ ^[0-9]+$ ]]; then
    echo "❌ Snapshot inválido: $snapshot_id"
    exit 1
  fi

  echo "⚠️  Vai ser executado rollback para o snapshot $snapshot_id"
  read -r -p "Confirmar rollback? [y/N] " confirm
  if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
    echo "Rollback cancelado."
    exit 1
  fi

  need_sudo snapper -c root rollback "$snapshot_id"
  echo "✅ Rollback executado. Reinicie o sistema para aplicar totalmente."
}

main() {
  local cmd="${1:-list}"

  case "$cmd" in
    list)
      list_snapshots
      ;;
    create)
      shift
      create_snapshot "${1:-}"
      ;;
    last)
      rollback_snapshot "$(load_last_snapshot)"
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      rollback_snapshot "$cmd"
      ;;
  esac
}

main "$@"
