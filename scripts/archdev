#!/bin/bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROFILE="${ARCHDEV_PROFILE:-full}"
PASS_FILE=""
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/archdev"
LAST_APPLY_FILE="$STATE_DIR/last-apply.env"
PROFILES_DIR="$ROOT_DIR/inventories/group_vars/profiles"
FEATURES_DIR="$ROOT_DIR/inventories/group_vars/features"
HOST_VARS_DIR="$ROOT_DIR/inventories/host_vars"
HOST_NAME="$( (command -v hostname >/dev/null 2>&1 && hostname -s) || uname -n )"
HOST_VARS_FILE="$HOST_VARS_DIR/${HOST_NAME}.yml"
FEATURE_FILES=(
  "$FEATURES_DIR/desktop.yml"
  "$FEATURES_DIR/laravel.yml"
  "$FEATURES_DIR/postgresql.yml"
  "$FEATURES_DIR/docker.yml"
  "$FEATURES_DIR/opencode.yml"
  "$FEATURES_DIR/redis.yml"
  "$FEATURES_DIR/dbeaver.yml"
)

profile_file_path() {
  local profile="$1"
  echo "$PROFILES_DIR/${profile}.yml"
}

list_profiles() {
  local profile_file
  local profile_name
  local first="true"

  if [[ ! -d "$PROFILES_DIR" ]]; then
    return 1
  fi

  for profile_file in "$PROFILES_DIR"/*.yml; do
    [[ -e "$profile_file" ]] || continue
    profile_name="$(basename "$profile_file" .yml)"
    if [[ "$first" == "true" ]]; then
      printf '%s' "$profile_name"
      first="false"
    else
      printf ', %s' "$profile_name"
    fi
  done
}

is_valid_profile() {
  local profile="$1"
  [[ -f "$(profile_file_path "$profile")" ]]
}

validate_profile() {
  local profile="$1"
  local available_profiles=""

  if ! is_valid_profile "$profile"; then
    available_profiles="$(list_profiles || true)"
    echo "❌ Perfil inválido: $profile"
    if [[ -n "$available_profiles" ]]; then
      echo "Use um dos perfis declarativos disponíveis: $available_profiles"
    fi
    exit 1
  fi
}

usage() {
  cat <<'EOF'
ArchDev command wrapper

Uso:
  scripts/archdev init
  scripts/archdev apply [minimal|dev|full]
  scripts/archdev explain [minimal|dev|full]
  scripts/archdev profiles
  scripts/archdev status
  scripts/archdev doctor
  scripts/archdev rollback list
  scripts/archdev rollback <snapshot_id>

Comandos:
  init     Instala dependências mínimas (git e ansible)
  apply    Deteta hardware, confirma host_vars e aplica um perfil
  explain  Mostra o contexto que o wrapper usará para um perfil
  profiles Lista os perfis declarativos disponíveis
  status   Mostra informação básica do ambiente actual
  doctor   Corre verificações pós-instalação
  rollback Lista snapshots ou faz rollback para um snapshot
EOF
}

section() {
  echo ""
  echo "$1"
  echo "$(printf '%*s' ${#1} '' | tr ' ' '=')"
}

need_root() {
  if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
    sudo "$@"
  else
    "$@"
  fi
}

cleanup() {
  if [[ -n "$PASS_FILE" && -f "$PASS_FILE" ]]; then
    rm -f "$PASS_FILE"
  fi
}

ensure_state_dir() {
  mkdir -p "$STATE_DIR"
}

ensure_host_vars_dir() {
  mkdir -p "$HOST_VARS_DIR"
}

read_host_var() {
  local key="$1"
  local file="$2"
  local line=""
  local value=""

  [[ -f "$file" ]] || return 1

  line="$(grep -E "^${key}:" "$file" 2>/dev/null | tail -n1 || true)"
  [[ -n "$line" ]] || return 1

  value="${line#*:}"
  value="${value# }"
  value="${value%\"}"
  value="${value#\"}"
  echo "$value"
}

load_profile_feature_context() {
  local profile_file=""

  ARCHDEV_FEATURE_DESKTOP="false"
  ARCHDEV_FEATURE_DEV="false"
  ARCHDEV_FEATURE_FULL="false"
  ARCHDEV_FEATURE_LARAVEL="false"
  ARCHDEV_FEATURE_POSTGRESQL="false"
  ARCHDEV_FEATURE_DOCKER="false"
  ARCHDEV_FEATURE_OPENCODE="false"
  ARCHDEV_FEATURE_REDIS="false"
  ARCHDEV_FEATURE_DBEAVER="false"

  if ! is_valid_profile "$ARCHDEV_DOCTOR_PROFILE"; then
    return 0
  fi

  profile_file="$(profile_file_path "$ARCHDEV_DOCTOR_PROFILE")"
  ARCHDEV_FEATURE_DESKTOP="$(normalize_bool "$(read_host_var feature_desktop "$profile_file" || printf '%s' 'false')")"
  ARCHDEV_FEATURE_DEV="$(normalize_bool "$(read_host_var feature_dev "$profile_file" || printf '%s' 'false')")"
  ARCHDEV_FEATURE_FULL="$(normalize_bool "$(read_host_var feature_full "$profile_file" || printf '%s' 'false')")"
  ARCHDEV_FEATURE_LARAVEL="$(normalize_bool "$(read_host_var feature_laravel "$profile_file" || printf '%s' 'false')")"
  ARCHDEV_FEATURE_POSTGRESQL="$(normalize_bool "$(read_host_var feature_postgresql "$profile_file" || printf '%s' 'false')")"
  ARCHDEV_FEATURE_DOCKER="$(normalize_bool "$(read_host_var feature_docker "$profile_file" || printf '%s' 'false')")"
  ARCHDEV_FEATURE_OPENCODE="$(normalize_bool "$(read_host_var feature_opencode "$profile_file" || printf '%s' 'false')")"
  ARCHDEV_FEATURE_REDIS="$(normalize_bool "$(read_host_var feature_redis "$profile_file" || printf '%s' 'false')")"
  ARCHDEV_FEATURE_DBEAVER="$(normalize_bool "$(read_host_var feature_dbeaver "$profile_file" || printf '%s' 'false')")"
}

load_runtime_context() {
  ARCHDEV_DOCTOR_PROFILE="${ARCHDEV_PROFILE:-$PROFILE}"
  ARCHDEV_DOCTOR_HARDWARE_TYPE="baremetal"
  ARCHDEV_DOCTOR_GRAPHICS_MODE="generic"
  ARCHDEV_DOCTOR_ENABLE_GPU_OVERRIDES="false"
  ARCHDEV_DOCTOR_ENABLE_ZRAM="false"
  ARCHDEV_DOCTOR_ENABLE_WLSUNSET="false"

  if [[ -f "$LAST_APPLY_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$LAST_APPLY_FILE"
    ARCHDEV_DOCTOR_PROFILE="${ARCHDEV_LAST_PROFILE:-$ARCHDEV_DOCTOR_PROFILE}"
  fi

  load_profile_feature_context

  if [[ -f "$HOST_VARS_FILE" ]]; then
    ARCHDEV_DOCTOR_HARDWARE_TYPE="$(read_host_var archdev_hardware_type "$HOST_VARS_FILE" || printf '%s' "$ARCHDEV_DOCTOR_HARDWARE_TYPE")"
    ARCHDEV_DOCTOR_GRAPHICS_MODE="$(read_host_var archdev_graphics_mode "$HOST_VARS_FILE" || printf '%s' "$ARCHDEV_DOCTOR_GRAPHICS_MODE")"
    ARCHDEV_DOCTOR_ENABLE_GPU_OVERRIDES="$(read_host_var archdev_enable_gpu_overrides "$HOST_VARS_FILE" || printf '%s' "$ARCHDEV_DOCTOR_ENABLE_GPU_OVERRIDES")"
    ARCHDEV_DOCTOR_ENABLE_ZRAM="$(read_host_var archdev_enable_zram "$HOST_VARS_FILE" || printf '%s' "$ARCHDEV_DOCTOR_ENABLE_ZRAM")"
    ARCHDEV_DOCTOR_ENABLE_WLSUNSET="$(read_host_var archdev_enable_wlsunset "$HOST_VARS_FILE" || printf '%s' "$ARCHDEV_DOCTOR_ENABLE_WLSUNSET")"
  fi
}

detect_virtualization_type() {
  local virt_type=""

  if command -v systemd-detect-virt >/dev/null 2>&1; then
    virt_type="$(systemd-detect-virt 2>/dev/null || true)"
  fi

  if [[ -z "$virt_type" || "$virt_type" == "none" ]]; then
    echo "baremetal"
  else
    echo "$virt_type"
  fi
}

detect_cpu_vendor() {
  local cpu_vendor="generic"

  if command -v lscpu >/dev/null 2>&1; then
    if lscpu | grep -qi 'AuthenticAMD\|AMD'; then
      cpu_vendor="amd"
    elif lscpu | grep -qi 'GenuineIntel\|Intel'; then
      cpu_vendor="intel"
    fi
  fi

  echo "$cpu_vendor"
}

detect_memory_mb() {
  awk '/MemTotal:/ { printf "%d", $2 / 1024 }' /proc/meminfo
}

detect_graphics_mode() {
  local virt_type="$1"
  local graphics_mode="generic"
  local lspci_output=""

  if [[ "$virt_type" == "vmware" ]]; then
    echo "vmware"
    return 0
  fi

  if [[ "$virt_type" == "oracle" || "$virt_type" == "virtualbox" ]]; then
    echo "virtualbox"
    return 0
  fi

  if [[ "$virt_type" == "kvm" || "$virt_type" == "qemu" ]]; then
    echo "kvm"
    return 0
  fi

  if command -v lspci >/dev/null 2>&1; then
    lspci_output="$(lspci 2>/dev/null | grep -Ei 'vga|3d|display' || true)"
    if grep -qi 'vmware' <<< "$lspci_output"; then
      graphics_mode="vmware"
    elif grep -qi 'virtualbox' <<< "$lspci_output"; then
      graphics_mode="virtualbox"
    elif grep -qi 'nvidia' <<< "$lspci_output"; then
      graphics_mode="nvidia"
    elif grep -qi 'amd\|ati\|radeon' <<< "$lspci_output"; then
      graphics_mode="amd"
    elif grep -qi 'intel' <<< "$lspci_output"; then
      graphics_mode="intel"
    fi
  fi

  echo "$graphics_mode"
}

default_gpu_overrides() {
  local graphics_mode="$1"

  if [[ "$graphics_mode" == "amd" ]]; then
    echo "true"
  else
    echo "false"
  fi
}

default_zram() {
  local memory_mb="$1"

  if (( memory_mb >= 8000 )); then
    echo "true"
  else
    echo "false"
  fi
}

default_wlsunset() {
  local virt_type="$1"

  if [[ "$virt_type" == "baremetal" ]]; then
    echo "true"
  else
    echo "false"
  fi
}

default_wlsunset_latitude() {
  echo "38.7"
}

default_wlsunset_longitude() {
  echo "-9.1"
}

prompt_with_default() {
  local prompt_text="$1"
  local default_value="$2"
  local answer=""

  read -r -p "$prompt_text [$default_value]: " answer
  if [[ -z "$answer" ]]; then
    echo "$default_value"
  else
    echo "$answer"
  fi
}

normalize_bool() {
  local value="${1:-false}"
  case "${value,,}" in
    y|yes|true|1|on)
      echo "true"
      ;;
    *)
      echo "false"
      ;;
  esac
}

detect_drm_path_by_index() {
  local index="$1"
  local path=""

  if compgen -G "/dev/dri/by-path/*-card" >/dev/null 2>&1; then
    path="$(printf '%s\n' /dev/dri/by-path/*-card | sort | sed -n "${index}p" || true)"
  fi

  echo "$path"
}

configure_hardware_profile() {
  local virt_type cpu_vendor memory_mb graphics_mode
  local enable_gpu_overrides enable_zram enable_wlsunset sddm_theme
  local primary_drm_path secondary_drm_path use_detected answer
  local wlsunset_latitude wlsunset_longitude

  ensure_host_vars_dir

  virt_type="$(detect_virtualization_type)"
  cpu_vendor="$(detect_cpu_vendor)"
  memory_mb="$(detect_memory_mb)"
  graphics_mode="$(detect_graphics_mode "$virt_type")"
  enable_gpu_overrides="$(default_gpu_overrides "$graphics_mode")"
  enable_zram="$(default_zram "$memory_mb")"
  enable_wlsunset="$(default_wlsunset "$virt_type")"
  wlsunset_latitude="$(default_wlsunset_latitude)"
  wlsunset_longitude="$(default_wlsunset_longitude)"
  sddm_theme="catppuccin-auto"
  primary_drm_path="$(detect_drm_path_by_index 1)"
  secondary_drm_path="$(detect_drm_path_by_index 2)"

  section "Hardware detectado"
  echo "Host vars alvo: $HOST_VARS_FILE"
  echo "- Ambiente: $virt_type"
  echo "- CPU: $cpu_vendor"
  echo "- RAM: ${memory_mb} MB"
  echo "- Gráficos: $graphics_mode"
  echo "- GPU overrides: $enable_gpu_overrides"
  echo "- ZRAM: $enable_zram"
  echo "- Wlsunset: $enable_wlsunset"
  if [[ "$enable_wlsunset" == "true" ]]; then
    echo "- Latitude: $wlsunset_latitude"
    echo "- Longitude: $wlsunset_longitude"
  fi
  echo "- Tema SDDM: $sddm_theme"

  if [[ "$enable_gpu_overrides" == "true" ]]; then
    echo "- DRM primário: ${primary_drm_path:-<não detetado>}"
    echo "- DRM secundário: ${secondary_drm_path:-<não detetado>}"
  fi

  echo ""
  read -r -p "Usar esta configuração detectada? [Y/n] " answer
  use_detected="${answer:-Y}"

  if [[ ! "$use_detected" =~ ^[Yy]$ ]]; then
    echo ""
    echo ">>> Ajuste assistido"
    virt_type="$(prompt_with_default "Ambiente (baremetal/vmware/virtualbox/kvm)" "$virt_type")"
    cpu_vendor="$(prompt_with_default "CPU vendor (amd/intel/generic)" "$cpu_vendor")"
    memory_mb="$(prompt_with_default "RAM em MB" "$memory_mb")"
    graphics_mode="$(prompt_with_default "Modo gráfico (generic/amd/intel/nvidia/vmware/virtualbox/kvm)" "$graphics_mode")"
    enable_gpu_overrides="$(normalize_bool "$(prompt_with_default "Ativar overrides de GPU? (true/false)" "$enable_gpu_overrides")")"
    enable_zram="$(normalize_bool "$(prompt_with_default "Ativar zram? (true/false)" "$enable_zram")")"
    enable_wlsunset="$(normalize_bool "$(prompt_with_default "Ativar wlsunset? (true/false)" "$enable_wlsunset")")"
    if [[ "$enable_wlsunset" == "true" ]]; then
      wlsunset_latitude="$(prompt_with_default "Latitude do wlsunset" "$wlsunset_latitude")"
      wlsunset_longitude="$(prompt_with_default "Longitude do wlsunset" "$wlsunset_longitude")"
    fi
    sddm_theme="$(prompt_with_default "Tema SDDM (default ou nome do tema)" "$sddm_theme")"
    if [[ "$enable_gpu_overrides" == "true" ]]; then
      primary_drm_path="$(prompt_with_default "DRM primário" "${primary_drm_path:-/dev/dri/by-path/SEU-DRM-PRIMARIO-card}")"
      secondary_drm_path="$(prompt_with_default "DRM secundário" "${secondary_drm_path:-/dev/dri/by-path/SEU-DRM-SECUNDARIO-card}")"
    fi
  fi

  cat > "$HOST_VARS_FILE" <<EOF
---
archdev_detected_hostname: "$HOST_NAME"
archdev_hardware_type: "$virt_type"
archdev_cpu_vendor: "$cpu_vendor"
archdev_target_ram_mb: $memory_mb
archdev_graphics_mode: "$graphics_mode"
archdev_enable_gpu_overrides: $enable_gpu_overrides
archdev_enable_zram: $enable_zram
archdev_enable_wlsunset: $enable_wlsunset
archdev_sddm_theme: "$sddm_theme"
EOF

  if [[ "$enable_wlsunset" == "true" ]]; then
    cat >> "$HOST_VARS_FILE" <<EOF
wlsunset_latitude: "$wlsunset_latitude"
wlsunset_longitude: "$wlsunset_longitude"
EOF
  fi

  if [[ "$enable_gpu_overrides" == "true" ]]; then
    cat >> "$HOST_VARS_FILE" <<EOF
primary_gpu_drm_path: "$primary_drm_path"
secondary_gpu_drm_path: "$secondary_drm_path"
EOF
  fi

  echo ""
  echo ">>> Host vars gravado em: $HOST_VARS_FILE"
}

show_rollback_hint() {
  if [[ -f "$LAST_APPLY_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$LAST_APPLY_FILE"
    if [[ -n "${ARCHDEV_PRE_SNAPSHOT:-}" ]]; then
      echo "    Snapshot pre-apply disponivel: ${ARCHDEV_PRE_SNAPSHOT}"
      echo "    Para listar snapshots: scripts/archdev rollback list"
      echo "    Para reverter:       scripts/archdev rollback ${ARCHDEV_PRE_SNAPSHOT}"
    fi
  fi
}

sudo_with_pass() {
  if [[ -n "$PASS_FILE" && -f "$PASS_FILE" ]]; then
    sudo -S "$@" < "$PASS_FILE"
  else
    need_root "$@"
  fi
}

can_use_snapper() {
  command -v snapper >/dev/null 2>&1 && sudo_with_pass snapper -c root get-config >/dev/null 2>&1
}

create_snapshot() {
  local phase="$1"
  local profile="$2"
  local ts snapshot_id description line

  ensure_state_dir

  if ! can_use_snapper; then
    echo "[aviso] Snapper não disponível; a aplicar sem snapshot $phase"
    return 0
  fi

  ts="$(date +%Y%m%d-%H%M%S)"
  description="ArchDev4-${phase}-${profile}-${ts}"
  line="$(sudo_with_pass snapper -c root create --print-number --description "$description" --cleanup-algorithm number 2>/dev/null | tail -n1 | tr -d '[:space:]' || true)"
  snapshot_id="${line##*=}"
  snapshot_id="${snapshot_id:-$line}"

  if [[ -n "$snapshot_id" ]]; then
    echo "[ok] snapshot $phase criado: $snapshot_id ($description)"
    printf 'ARCHDEV_%s_SNAPSHOT=%s\n' "${phase^^}" "$snapshot_id" >> "$LAST_APPLY_FILE"
    printf 'ARCHDEV_%s_DESCRIPTION=%q\n' "${phase^^}" "$description" >> "$LAST_APPLY_FILE"
  else
    echo "[aviso] não foi possível determinar o ID do snapshot $phase"
  fi
}

write_apply_state_header() {
  local profile="$1"
  ensure_state_dir
  cat > "$LAST_APPLY_FILE" <<EOF
ARCHDEV_LAST_PROFILE=$profile
ARCHDEV_LAST_APPLY_TS=$(date +%Y%m%d-%H%M%S)
EOF
}

capture_sudo_password() {
  local sudo_pass

  echo ""
  echo ">>> Autenticação sudo necessária"
  read -r -s -p "Password sudo: " sudo_pass
  echo ""

  if ! printf '%s\n' "$sudo_pass" | sudo -S true 2>/dev/null; then
    echo "❌ Password sudo incorreta"
    exit 1
  fi

  PASS_FILE=$(mktemp /tmp/.archdev-pass-XXXXXX)
  chmod 600 "$PASS_FILE"
  printf '%s\n' "$sudo_pass" > "$PASS_FILE"
}

cmd_init() {
  echo ">>> ArchDev init"
  need_root pacman -Sy --noconfirm --needed git ansible
}

cmd_apply() {
  local profile="${1:-$PROFILE}"
  local apply_rc=0
  local doctor_rc=0

  validate_profile "$profile"

  capture_sudo_password
  trap cleanup EXIT INT TERM
  configure_hardware_profile

  write_apply_state_header "$profile"
  create_snapshot pre "$profile"

  if ansible-playbook \
    -i "$ROOT_DIR/inventory/hosts.yml" \
    "$ROOT_DIR/playbooks/site-4.yml" \
    --become-password-file="$PASS_FILE" \
    -e "archdev_profile=${profile}"; then
    apply_rc=0
  else
    apply_rc=$?
    echo ""
    echo ">>> O apply falhou antes da validacao final"
    show_rollback_hint
    return $apply_rc
  fi

  create_snapshot post "$profile"

  echo ""
  echo ">>> A correr doctor pós-apply"
  if ! cmd_doctor; then
    doctor_rc=$?
  fi

  if [[ $doctor_rc -ne 0 ]]; then
    echo ""
    echo ">>> O doctor encontrou problemas após o apply"
    show_rollback_hint
    return $doctor_rc
  fi
}

cmd_status() {
  local effective_profile="$PROFILE"
  local available_profiles=""

  load_runtime_context
  available_profiles="$(list_profiles || true)"

  echo "ArchDev status"
  echo "============="
  echo "Repo: $ROOT_DIR"
  echo "Perfil por omissão: $PROFILE"
  echo "Host detectado: $HOST_NAME"
  echo "Host vars esperado: $HOST_VARS_FILE"

  if [[ -f "$LAST_APPLY_FILE" ]]; then
    effective_profile="$ARCHDEV_DOCTOR_PROFILE"
  fi

  echo "Perfil efectivo: $effective_profile"
  if [[ -n "$available_profiles" ]]; then
    echo "Perfis declarativos: $available_profiles"
  fi
  echo "Hardware: $ARCHDEV_DOCTOR_HARDWARE_TYPE"
  echo "Gráficos: $ARCHDEV_DOCTOR_GRAPHICS_MODE"
  echo "GPU overrides: $ARCHDEV_DOCTOR_ENABLE_GPU_OVERRIDES"
  echo "ZRAM: $ARCHDEV_DOCTOR_ENABLE_ZRAM"
  echo "Wlsunset: $ARCHDEV_DOCTOR_ENABLE_WLSUNSET"
  if [[ "$ARCHDEV_DOCTOR_ENABLE_WLSUNSET" == "true" ]]; then
    echo "Latitude: $(read_host_var wlsunset_latitude "$HOST_VARS_FILE" || printf '%s' "${wlsunset_latitude:-38.7}")"
    echo "Longitude: $(read_host_var wlsunset_longitude "$HOST_VARS_FILE" || printf '%s' "${wlsunset_longitude:--9.1}")"
  fi

  if [[ -f "$HOST_VARS_FILE" ]]; then
    echo "Host vars: presente"
  else
    echo "Host vars: ausente"
  fi

  echo ""
  echo "Ferramentas:"
  for cmd in ansible docker psql opencode laravel git; do
    if command -v "$cmd" >/dev/null 2>&1; then
      echo "  - $cmd: ok"
    else
      echo "  - $cmd: ausente"
    fi
  done
  echo ""
  echo "Serviços:"
  for svc in NetworkManager docker postgresql bluetooth; do
    if systemctl is-enabled "$svc" >/dev/null 2>&1; then
      echo "  - $svc: enabled"
    else
      echo "  - $svc: disabled/ausente"
    fi
  done

  if [[ -f "$LAST_APPLY_FILE" ]]; then
    echo ""
    echo "Último apply:"
    echo "  - perfil: ${ARCHDEV_LAST_PROFILE:-desconhecido}"
    echo "  - timestamp: ${ARCHDEV_LAST_APPLY_TS:-desconhecido}"
    if [[ -n "${ARCHDEV_PRE_SNAPSHOT:-}" ]]; then
      echo "  - snapshot pre: ${ARCHDEV_PRE_SNAPSHOT}"
    fi
    if [[ -n "${ARCHDEV_POST_SNAPSHOT:-}" ]]; then
      echo "  - snapshot post: ${ARCHDEV_POST_SNAPSHOT}"
    fi
  fi
}

cmd_profiles() {
  local profile_file
  local profile_name

  echo "Perfis declarativos"
  echo "===================="

  if [[ ! -d "$PROFILES_DIR" ]]; then
    echo "❌ Diretório de perfis não encontrado: $PROFILES_DIR"
    exit 1
  fi

  for profile_file in "$PROFILES_DIR"/*.yml; do
    [[ -e "$profile_file" ]] || continue
    profile_name="$(basename "$profile_file" .yml)"
    echo "- $profile_name ($profile_file)"
  done
}

cmd_explain() {
  local profile="${1:-$PROFILE}"
  local profile_file=""
  local feature_name=""
  local feature_value=""
  local feature_file=""
  local profile_label=""
  local feature_keys=(
    feature_desktop
    feature_dev
    feature_full
    feature_laravel
    feature_postgresql
    feature_docker
    feature_opencode
    feature_redis
    feature_dbeaver
  )

  validate_profile "$profile"
  load_runtime_context
  profile_file="$(profile_file_path "$profile")"
  profile_label="$(read_host_var archdev_profile_name "$profile_file" || printf '%s' "$profile")"

  echo "Contexto do wrapper 4.0"
  echo "========================"
  echo "Perfil pedido: $profile"
  echo "Perfil resolvido: $profile_label"
  echo "Ficheiro do perfil: $profile_file"
  echo "Host detetado: $HOST_NAME"
  echo "Host vars esperado: $HOST_VARS_FILE"

  if [[ -f "$HOST_VARS_FILE" ]]; then
    echo "Host vars actual: presente"
  else
    echo "Host vars actual: ausente"
  fi

  echo ""
  echo "Features do perfil:"
  for feature_name in "${feature_keys[@]}"; do
    feature_value="$(read_host_var "$feature_name" "$profile_file" || printf '%s' 'false')"
    echo "  - $feature_name: $feature_value"
  done

  echo ""
  echo "Feature files carregados por site-4.yml:"
  for feature_file in "${FEATURE_FILES[@]}"; do
    if [[ -f "$feature_file" ]]; then
      echo "  - ok: $feature_file"
    else
      echo "  - ausente: $feature_file"
    fi
  done

  echo ""
  echo "Contexto local conhecido pelo wrapper:"
  echo "  - hardware: $ARCHDEV_DOCTOR_HARDWARE_TYPE"
  echo "  - gráficos: $ARCHDEV_DOCTOR_GRAPHICS_MODE"
  echo "  - gpu overrides: $ARCHDEV_DOCTOR_ENABLE_GPU_OVERRIDES"
  echo "  - zram: $ARCHDEV_DOCTOR_ENABLE_ZRAM"
  echo "  - wlsunset: $ARCHDEV_DOCTOR_ENABLE_WLSUNSET"
  if [[ "$ARCHDEV_DOCTOR_ENABLE_WLSUNSET" == "true" ]]; then
    echo "  - latitude: $(read_host_var wlsunset_latitude "$HOST_VARS_FILE" || printf '%s' '38.7')"
    echo "  - longitude: $(read_host_var wlsunset_longitude "$HOST_VARS_FILE" || printf '%s' '-9.1')"
  fi
}

cmd_doctor() {
  local failures=0
  local warnings=0

  load_runtime_context

  check_cmd() {
    local cmd="$1"
    local label="${2:-$1}"
    if command -v "$cmd" >/dev/null 2>&1; then
      echo "[ok] comando: $label"
    else
      echo "[falha] comando ausente: $label"
      failures=$((failures + 1))
    fi
  }

  check_service() {
    local svc="$1"
    local label="${2:-$1}"
    if systemctl is-active --quiet "$svc"; then
      echo "[ok] serviço: $label"
    else
      echo "[falha] serviço inactivo: $label"
      failures=$((failures + 1))
    fi
  }

  warn() {
    echo "[aviso] $1"
    warnings=$((warnings + 1))
  }

  requirement_from_flag() {
    local flag_value="${1:-false}"

    if [[ "$flag_value" == "true" ]]; then
      echo "required"
    else
      echo "optional"
    fi
  }

  require_for_dev() {
    [[ "$ARCHDEV_FEATURE_DEV" == "true" ]]
  }

  require_for_full() {
    [[ "$ARCHDEV_FEATURE_FULL" == "true" ]]
  }

  is_virtualized_guest() {
    [[ "$ARCHDEV_DOCTOR_HARDWARE_TYPE" != "baremetal" ]]
  }

check_file() {
    local path="$1"
    local label="${2:-$1}"
    if [[ -e "$path" ]]; then
      echo "[ok] ficheiro: $label"
    else
      echo "[falha] ficheiro ausente: $label"
      failures=$((failures + 1))
    fi
  }

  check_enabled() {
    local svc="$1"
    local label="${2:-$1}"
    if systemctl is-enabled "$svc" >/dev/null 2>&1; then
      echo "[ok] serviço activado: $label"
    else
      warn "serviço não activado: $label"
    fi
  }

  check_cmd_profiled() {
    local cmd="$1"
    local label="$2"
    local requirement="$3"

    if command -v "$cmd" >/dev/null 2>&1; then
      echo "[ok] comando: $label"
      return 0
    fi

    if [[ "$requirement" == "required" ]]; then
      echo "[falha] comando ausente: $label"
      failures=$((failures + 1))
    else
      warn "comando opcional ausente para o perfil ${ARCHDEV_DOCTOR_PROFILE}: $label"
    fi
  }

  check_service_profiled() {
    local svc="$1"
    local label="$2"
    local requirement="$3"

    if systemctl is-active --quiet "$svc"; then
      echo "[ok] serviço: $label"
      return 0
    fi

    if [[ "$requirement" == "required" ]]; then
      echo "[falha] serviço inactivo: $label"
      failures=$((failures + 1))
    else
      warn "serviço opcional inactivo para o perfil ${ARCHDEV_DOCTOR_PROFILE}: $label"
    fi
  }

  check_enabled_profiled() {
    local svc="$1"
    local label="$2"
    local requirement="$3"

    if systemctl is-enabled "$svc" >/dev/null 2>&1; then
      echo "[ok] serviço activado: $label"
      return 0
    fi

    if [[ "$requirement" == "required" ]]; then
      warn "serviço obrigatório não activado: $label"
    else
      warn "serviço opcional não activado para o perfil ${ARCHDEV_DOCTOR_PROFILE}: $label"
    fi
  }

  check_file_profiled() {
    local path="$1"
    local label="$2"
    local requirement="$3"

    if [[ -e "$path" ]]; then
      echo "[ok] ficheiro: $label"
      return 0
    fi

    if [[ "$requirement" == "required" ]]; then
      echo "[falha] ficheiro ausente: $label"
      failures=$((failures + 1))
    else
      warn "ficheiro opcional ausente para o perfil ${ARCHDEV_DOCTOR_PROFILE}: $label"
    fi
  }

  echo ">>> ArchDev doctor"
  echo "[info] perfil activo: ${ARCHDEV_DOCTOR_PROFILE}"
  echo "[info] hardware: ${ARCHDEV_DOCTOR_HARDWARE_TYPE} / graficos: ${ARCHDEV_DOCTOR_GRAPHICS_MODE}"
  echo "[info] features: desktop=${ARCHDEV_FEATURE_DESKTOP} dev=${ARCHDEV_FEATURE_DEV} laravel=${ARCHDEV_FEATURE_LARAVEL} postgresql=${ARCHDEV_FEATURE_POSTGRESQL} docker=${ARCHDEV_FEATURE_DOCKER} opencode=${ARCHDEV_FEATURE_OPENCODE} redis=${ARCHDEV_FEATURE_REDIS} dbeaver=${ARCHDEV_FEATURE_DBEAVER}"

  section "Base"
  check_cmd ansible
  check_cmd git
  check_cmd curl
  check_cmd sudo

  section "Contexto Declarativo"
  if [[ -d "$PROFILES_DIR" ]]; then
    echo "[ok] diretório de perfis: $PROFILES_DIR"
  else
    echo "[falha] diretório de perfis ausente: $PROFILES_DIR"
    failures=$((failures + 1))
  fi

  if [[ -d "$FEATURES_DIR" ]]; then
    echo "[ok] diretório de features: $FEATURES_DIR"
  else
    echo "[falha] diretório de features ausente: $FEATURES_DIR"
    failures=$((failures + 1))
  fi

  if is_valid_profile "$ARCHDEV_DOCTOR_PROFILE"; then
    echo "[ok] perfil declarativo válido: $ARCHDEV_DOCTOR_PROFILE"
  else
    echo "[falha] perfil declarativo inválido: $ARCHDEV_DOCTOR_PROFILE"
    failures=$((failures + 1))
  fi

  for feature_file in "${FEATURE_FILES[@]}"; do
    check_file "$feature_file" "feature declarativa $(basename "$feature_file")"
  done

  if [[ -f "$HOST_VARS_FILE" ]]; then
    echo "[ok] host_vars detectado: $HOST_VARS_FILE"
  else
    warn "host_vars ainda ausente para este host: $HOST_VARS_FILE"
  fi

  section "Sistema"
  check_service NetworkManager
  check_enabled NetworkManager

  if is_virtualized_guest; then
    warn "bluetooth ignorado em ambiente virtualizado (${ARCHDEV_DOCTOR_HARDWARE_TYPE})"
  else
    check_service bluetooth
    check_enabled bluetooth
  fi

  check_service sshd
  check_enabled sshd
  check_service ufw
  check_enabled ufw

  if command -v findmnt >/dev/null 2>&1; then
    if [[ "$(findmnt -n -o FSTYPE / 2>/dev/null || true)" == "btrfs" ]]; then
      echo "[ok] root em Btrfs"
    else
      warn "root não está em Btrfs"
    fi
  fi

  if command -v snapper >/dev/null 2>&1; then
    if sudo_with_pass snapper -c root get-config >/dev/null 2>&1; then
      echo "[ok] snapper root configurado"
    else
      warn "snapper instalado mas configuração root não está pronta"
    fi
  else
    warn "snapper ausente"
  fi

  check_file /boot/limine/limine.conf "configuração Limine"

  section "Desktop"
  check_cmd_profiled Hyprland "Hyprland" "$(requirement_from_flag "$ARCHDEV_FEATURE_DESKTOP")"
  check_cmd_profiled waybar "waybar" "$(requirement_from_flag "$ARCHDEV_FEATURE_DESKTOP")"
  check_cmd_profiled rofi "rofi" "$(requirement_from_flag "$ARCHDEV_FEATURE_DESKTOP")"
  check_cmd_profiled kitty "kitty" "$(requirement_from_flag "$ARCHDEV_FEATURE_DESKTOP")"
  check_cmd_profiled firefox "firefox" "$(requirement_from_flag "$ARCHDEV_FEATURE_DESKTOP")"

  if [[ "$ARCHDEV_DOCTOR_ENABLE_GPU_OVERRIDES" == "true" ]]; then
    check_file /etc/environment.d/90-archdev-gpu.conf "override de GPU"
  else
    echo "[ok] override de GPU não requerido para ${ARCHDEV_DOCTOR_GRAPHICS_MODE}"
  fi

  section "Desenvolvimento"
  check_cmd_profiled python "python" "$(requirement_from_flag "$ARCHDEV_FEATURE_DEV")"
  check_cmd_profiled poetry "poetry" "$(requirement_from_flag "$ARCHDEV_FEATURE_DEV")"
  check_cmd_profiled php "php" "$(requirement_from_flag "$ARCHDEV_FEATURE_LARAVEL")"
  check_cmd_profiled composer "composer" "$(requirement_from_flag "$ARCHDEV_FEATURE_LARAVEL")"
  check_cmd_profiled laravel "laravel" "$(requirement_from_flag "$ARCHDEV_FEATURE_LARAVEL")"

  if [[ "$ARCHDEV_FEATURE_LARAVEL" == "true" || "$ARCHDEV_FEATURE_OPENCODE" == "true" ]]; then
    check_cmd_profiled node "node" required
    check_cmd_profiled npm "npm" required
  else
    check_cmd_profiled node "node" optional
    check_cmd_profiled npm "npm" optional
  fi

  check_cmd_profiled opencode "opencode" "$(requirement_from_flag "$ARCHDEV_FEATURE_OPENCODE")"
  check_cmd_profiled docker "docker" "$(requirement_from_flag "$ARCHDEV_FEATURE_DOCKER")"
  check_cmd_profiled psql "psql" "$(requirement_from_flag "$ARCHDEV_FEATURE_POSTGRESQL")"
  check_cmd_profiled pg_isready "pg_isready" "$(requirement_from_flag "$ARCHDEV_FEATURE_POSTGRESQL")"

  if [[ "$ARCHDEV_FEATURE_LARAVEL" == "true" ]] && command -v php >/dev/null 2>&1; then
    php -m | grep -q '^pdo_pgsql$' && echo "[ok] extensão PHP: pdo_pgsql" || { echo "[falha] extensão PHP ausente: pdo_pgsql"; failures=$((failures + 1)); }
    php -m | grep -q '^mbstring$' && echo "[ok] extensão PHP: mbstring" || { echo "[falha] extensão PHP ausente: mbstring"; failures=$((failures + 1)); }
  fi

  check_service_profiled docker "docker" "$(requirement_from_flag "$ARCHDEV_FEATURE_DOCKER")"
  check_enabled_profiled docker "docker" "$(requirement_from_flag "$ARCHDEV_FEATURE_DOCKER")"

  if [[ "$ARCHDEV_FEATURE_DOCKER" == "true" ]] && command -v docker >/dev/null 2>&1; then
    if docker info >/dev/null 2>&1; then
      echo "[ok] acesso Docker sem sudo"
    else
      warn "Docker instalado mas o utilizador actual pode ainda precisar de logout/login"
    fi
  fi

  check_service_profiled postgresql "postgresql" "$(requirement_from_flag "$ARCHDEV_FEATURE_POSTGRESQL")"
  check_enabled_profiled postgresql "postgresql" "$(requirement_from_flag "$ARCHDEV_FEATURE_POSTGRESQL")"

  if [[ "$ARCHDEV_FEATURE_POSTGRESQL" == "true" ]] && command -v pg_isready >/dev/null 2>&1; then
    if pg_isready -q; then
      echo "[ok] PostgreSQL responde a pg_isready"
    else
      warn "PostgreSQL activo mas ainda não responde a pg_isready"
    fi
  fi

  section "Helpers"
  check_file_profiled /usr/local/bin/archdev-postgresql-setup "archdev-postgresql-setup" "$(requirement_from_flag "$ARCHDEV_FEATURE_POSTGRESQL")"
  check_file_profiled /usr/local/bin/archdev-bitwarden-setup "archdev-bitwarden-setup" "$(requirement_from_flag "$ARCHDEV_FEATURE_DEV")"
  check_file_profiled /usr/local/bin/archdev-backup-keys "archdev-backup-keys" "$(requirement_from_flag "$ARCHDEV_FEATURE_DEV")"
  check_file_profiled /usr/local/bin/archdev-gpu-status "archdev-gpu-status" "$(requirement_from_flag "$ARCHDEV_FEATURE_DEV")"

  if [[ -x /usr/local/bin/archdev-gpu-status ]]; then
    /usr/local/bin/archdev-gpu-status || true
  fi

  if [[ $failures -gt 0 ]]; then
    echo ""
    echo ">>> Doctor terminou com $failures falha(s) e $warnings aviso(s)"
    return 1
  fi

  echo ""
  echo ">>> Doctor sem falhas${warnings:+ ($warnings aviso(s))}"
  return 0
}

cmd_rollback() {
  local action="${1:-list}"

  capture_sudo_password
  trap cleanup EXIT INT TERM

  if ! can_use_snapper; then
    echo "❌ Snapper não está disponível/configurado."
    exit 1
  fi

  if [[ "$action" == "list" ]]; then
    sudo_with_pass snapper -c root list
    return 0
  fi

  if [[ ! "$action" =~ ^[0-9]+$ ]]; then
    echo "❌ Snapshot inválido: $action"
    echo "Use: scripts/archdev rollback list"
    exit 1
  fi

  echo "⚠️  Vai ser executado rollback para o snapshot $action"
  read -r -p "Confirmar rollback? [y/N] " confirm
  if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
    echo "Rollback cancelado."
    exit 1
  fi

  sudo_with_pass snapper -c root rollback "$action"
  echo "✅ Rollback executado. Reinicie o sistema para aplicar totalmente."
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    init)
      shift
      cmd_init "$@"
      ;;
    apply)
      shift
      cmd_apply "$@"
      ;;
    explain)
      shift
      cmd_explain "$@"
      ;;
    profiles)
      shift
      cmd_profiles "$@"
      ;;
    status)
      shift
      cmd_status "$@"
      ;;
    doctor)
      shift
      cmd_doctor "$@"
      ;;
    rollback)
      shift
      cmd_rollback "$@"
      ;;
    ""|-h|--help|help)
      usage
      ;;
    *)
      echo "Comando inválido: $cmd"
      echo ""
      usage
      exit 1
      ;;
  esac
}

main "$@"
